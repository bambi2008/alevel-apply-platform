APP_ORIGIN=http://127.0.0.1:3200
AUTH_URL=http://127.0.0.1:3200
ALLOW_HTTP_PRODUCTION=true
APP_ENV_FILE=.env.preproduction
APP_IMAGE=qiaoshen-app:preproduction
PREPRODUCTION_PORT=3200
PREPRODUCTION_DB_PORT=5434
AUTH_SECRET=replace-with-at-least-32-random-characters
PRIVACY_CONTACT_EMAIL=privacy@example.test

EMAIL_DRIVER=resend
RESEND_API_KEY=preproduction-placeholder
EMAIL_FROM=QiaoShen Preproduction <account@example.test>
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

POSTGRES_USER=qiaoshen_preproduction
POSTGRES_DB=qiaoshen_preproduction
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://qiaoshen_preproduction:replace-with-a-long-random-password@postgres:5432/qiaoshen_preproduction

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/.storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
REQUIRE_BACKUPS=true
BACKUP_DIR=/backups
BACKUP_RETENTION_COUNT=5
BACKUP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

AI_ENABLED=false
AI_REQUIRES_CROSS_BORDER_CONSENT=true
SENTRY_DSN=
APP_RELEASE=preproduction
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
OPERATIONS_ALERT_THROTTLE_MINUTES=15
OPERATIONS_EVENT_THROTTLE_SECONDS=60
BACKUP_MAX_AGE_HOURS=30
