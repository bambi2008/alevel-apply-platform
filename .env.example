# ---- 数据库 ----
# 本地 Postgres 示例（请按实际修改）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alevel_apply?schema=public"

# ---- Auth（数据库会话）----
# 生成： openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
APP_ORIGIN="http://localhost:3100"
# Temporary invite-only registration. Set to open only for the approved public launch.
REGISTRATION_MODE="invite"
# Enable only after the v4 review and dedicated stable secret are configured.
TRIAL_PROGRAM_ENABLED="false"
# TRIAL_DEDUP_SECRET=  # server only, >=32 random bytes; do not rotate with AUTH_SECRET
# TRIAL_PROGRAM_ENDED_AT=  # permanent ISO date of programme end; keep disabled thereafter
SEASON_PASS_PRICE_FEN="39900"
SEASON_PASS_MONTHS="3"
# Owner-configured administrator emails, comma-separated; no automatic fallback.
ADMIN_EMAILS=""
# Daily 03:00 Asia/Shanghai purge of study data created at least 365 days ago.
# Build/local checks never run this worker. Verify dry-run before deployment.
DATA_RETENTION_ENABLED="true"
PRIVACY_CONTACT_EMAIL="hello@drforest.ai"

# Password reset email is printed to the server console in development.
EMAIL_DRIVER="console"

# Development-only phone code flow. Production must keep this disabled.
NEXT_PUBLIC_PHONE_AUTH_ENABLED="true"

# ---- 功能开关 ----
AI_ENABLED="false"
DEEPSEEK_MODEL="deepseek-flash"
AI_REQUIRES_CROSS_BORDER_CONSENT="true"
# 单次评分 5–60 秒；后台会记录超时、延迟和 Token。
AI_GRADING_TIMEOUT_MS="25000"
# 填写模型供应商每百万 Token 的美元单价后，后台显示估算成本。
# DEEPSEEK_INPUT_USD_PER_M_TOKENS=""
# DEEPSEEK_OUTPUT_USD_PER_M_TOKENS=""

# ---- 存储 ----
# 当前代码支持 local；正式部署应挂载持久卷并独立备份。
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="C:/qiaoshen/storage"
ALLOW_LOCAL_STORAGE_IN_PRODUCTION="false"

# ---- 考季卡（默认关闭；上线前仅供管理员小额测试）----
PAYMENTS_ENABLED="false"
PAYMENTS_ADMIN_ONLY="true"
PAYMENT_PROVIDER="mianbaoduo"
PAYMENT_PARENT_HINT="false"
MEMBERSHIP_REMINDERS_ENABLED="false"
# PAYMENT_TEST_AMOUNT_FEN=
# MBD_APP_ID=
# MBD_APP_KEY=
# MBD_WEBHOOK_PATH_TOKEN=
# MBD_WEBHOOK_IP_ALLOWLIST=49.233.5.148,140.143.158.124

# ---- 通知 ----
# ALIYUN_SMS_KEY=
# ALIYUN_SMS_SECRET=
# RESEND_API_KEY=
