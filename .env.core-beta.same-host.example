# Same-host four-core Beta environment. Keep production env and Beta env separate.
APP_DOMAIN=beta.qiaoshenedu.com
APP_ORIGIN=https://beta.qiaoshenedu.com
AUTH_URL=https://beta.qiaoshenedu.com
APP_ENV_FILE=.env.core-beta.same-host
APP_IMAGE=qiaoshen-core-beta:local
APP_RELEASE=core-beta-same-host
PRODUCTION_FRONTEND_NETWORK=qiaoshen_frontend
AUTH_SECRET=replace-with-at-least-32-random-characters
PRIVACY_CONTACT_EMAIL=privacy@qiaoshenedu.com

EMAIL_DRIVER=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="QiaoShen Beta <account@mail.qiaoshenedu.com>"
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# Use hexadecimal passwords so DATABASE_URL needs no URL escaping.
POSTGRES_USER=qiaoshen_beta
POSTGRES_DB=qiaoshen_beta
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
DATABASE_URL=postgresql://qiaoshen_beta:replace-with-a-long-random-hex-password@postgres:5432/qiaoshen_beta

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/.storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true

REQUIRE_BACKUPS=true
BACKUP_DIR=/backups
BACKUP_RETENTION_COUNT=14
BACKUP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

AI_ENABLED=false
DEEPSEEK_API_KEY=
AI_REQUIRES_CROSS_BORDER_CONSENT=true
SENTRY_DSN=
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_TOKEN=
OPERATIONS_ALERT_THROTTLE_MINUTES=15
OPERATIONS_EVENT_THROTTLE_SECONDS=60
BACKUP_MAX_AGE_HOURS=30
