www.{$APP_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
  encode zstd gzip
  log_skip /api/pay/mianbaoduo/webhook*
  # Use the production container's unique DNS name. The same-host Beta
  # Compose project also has a service named "app" on this network.
  reverse_proxy qiaoshen-app-1:3000

  header {
    -Server
  }

  log {
    output stdout
    format json
  }
}

{$BETA_DOMAIN} {
  encode zstd gzip
  log_skip /api/pay/mianbaoduo/webhook*
  reverse_proxy qiaoshen-core-beta-app:3000

  header {
    -Server
  }

  log {
    output stdout
    format json
  }
}
