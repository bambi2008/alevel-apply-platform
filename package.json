{
  "name": "alevel-apply-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "audit:questions": "tsx scripts/audit-question-bank.ts",
    "audit:tmua": "tsx scripts/audit-tmua-mocks.ts",
    "audit:esat": "tsx scripts/audit-esat-mocks.ts",
    "audit:tara": "tsx scripts/audit-tara-mocks.ts",
    "audit:lnat": "tsx scripts/audit-lnat-mocks.ts",
    "audit:release": "tsx scripts/audit-question-release.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:start": "node scripts/pg.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "preflight:production": "node scripts/check-production-env.mjs",
    "start:production": "node scripts/start-production.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "restore:production": "node scripts/restore-production.mjs",
    "deploy:production": "node scripts/deploy-release.mjs",
    "rollback:production": "node scripts/rollback-release.mjs",
    "drill:preproduction": "node scripts/preproduction-drill.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "check:beta-capacity": "node scripts/beta-capacity-check.mjs",
