// A-Level 留学申请平台 — Prisma schema (Phase 1)
// 说明：核心模型已落地；Phase 2 预留模型见文件末尾注释。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // RAG 预留：实现向量检索时再启用 pgvector 扩展
  // （generator 加 previewFeatures = ["postgresqlExtensions"]，datasource 加 extensions = [pgvector]）
}

// ---------- 账户 ----------
enum Role {
  STUDENT
  ADMIN
  MENTOR
}

model User {
  id                   String                @id @default(cuid())
  phone                String?               @unique
  email                String?               @unique
  passwordHash         String?
  role                 Role                  @default(STUDENT)
  locale               String                @default("zh-CN")
  profile              StudentProfile?
  consents             Consent[]
  documents            Document[]
  studentProjects      StudentProject[]
  applicationPreps     ApplicationPrep[]
  auditLogs            AuditLog[]
  calibrationDecisions CalibrationDecision[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

enum ConsentType {
  PRIVACY_PIPL
  CROSS_BORDER
  GUARDIAN
  MARKETING
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  version   String
  grantedAt DateTime    @default(now())

  @@index([userId])
}

// ---------- 学生档案 ----------
enum Region {
  UK
  HK
}

model StudentProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String?
  school          String?
  isMinor         Boolean             @default(false)
  intakeYear      Int?
  targetRegions   Region[]
  intendedMajors  String[]
  budgetNote      String?
  guideProgress   Json? // 申请指南清单进度：ModuleProgress[]
  subjects        ALevelSubject[]
  testScores      TestScore[]
  applications    Application[]
  statements      PersonalStatement[]
  tasks           Task[]
  examSessions    ExamSession[]
  backgroundItems BackgroundItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum GradeKind {
  AS
  PREDICTED
  ACTUAL
}

model ALevelSubject {
  id        String         @id @default(cuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject   String
  kind      GradeKind
  grade     String // A*, A, B, C, D, E, U

  @@index([profileId])
}

model TestScore {
  id        String         @id @default(cuid())
  profileId String
  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String // IELTS / TOEFL / DUOLINGO
  overall   Float?
  subscores Json?
  takenAt   DateTime?

  @@index([profileId])
}

// ---------- 院校与专业（字段对齐 docs/product/02_院校字段表.md）----------
enum AppSystem {
  UCAS
  DIRECT
  BOTH
}

model University {
  id                   String     @id @default(cuid())
  name                 String // 英文全称
  nameZh               String?
  region               Region // UK / HK
  city                 String?
  league               String? // Russell Group / HK UGC 8 ...
  qsRankWorld          Int?
  qsRankSubject        Json? // { "Computer Science": 5, ... }
  ucasCode             String? // 单字母院校代码（UK）
  ucasInstitutionCode  String? // 四位字母代码
  website              String?
  admissionsUrl        String?
  logoUrl              String?
  // 申请系统
  applicationSystem    AppSystem?
  applicationPortalUrl String?
  applicationFeeGbp    Int?
  applicationFeeHkd    Int?
  maxChoices           Int? // UK=5；HK 无限制可留空
  // 截止与时间
  openDate             DateTime?
  deadlineEarly        DateTime? // 牛剑 / 医学等
  deadlineMain         DateTime?
  deadlineLate         DateTime?
  resultReleaseFrom    DateTime?
  resultReleaseTo      DateTime?
  ranking              Json?
  programs             Program[]

  @@index([region])
}

enum ApplyRoute {
  UCAS
  HK_DIRECT
}

enum DegreeType {
  BA
  BSc
  BEng
  LLB
  MBChB
  OTHER
}

model Program {
  id                    String      @id @default(cuid())
  universityId          String
  university            University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name                  String // 英文课程名
  nameZh                String?
  field                 String? // 专业方向/学科领域，如 cs / aerospace（见 lib/constants FIELDS）
  degreeType            DegreeType?
  durationYears         Int?
  applyRoute            ApplyRoute
  ucasCourseCode        String?
  coursePageUrl         String?
  mode                  String? // Full-time / Part-time
  acceptsGapYear        Boolean?
  deadlineEarlyOverride DateTime? // 课程级覆盖（牛剑 / 医学）

  // 学费
  annualTuitionGbp Int?
  annualTuitionHkd Int?

  // 入学要求 - 成绩
  alevelOfferTypical String? // 典型 "AAB"
  alevelOfferMinimum String? // 最低 "ABB"
  requiredSubjects   Json? // [{ subject, minGrade }]
  preferredSubjects  String[]
  excludedSubjects   String[] // 如 General Studies
  asLevelRequired    Boolean?
  epqConsidered      Boolean?
  gcseMinEnglish     Int?
  gcseMinMaths       Int?
  ibMinimum          Int?
  satAccepted        Boolean?

  // 入学要求 - 语言
  ieltsOverall       Float?
  ieltsSubscores     Json? // { writing, speaking, listening, reading }
  toeflMinimum       Int?
  languageExemptions String?

  // 入学考试 / 面试
  admissionsTest    String? // LNAT / UCAT / MAT / TMUA ...
  interviewRequired Boolean?

  // 奖学金
  scholarshipAvailable Boolean?
  scholarshipUrl       String?

  // 录取数据（历史参考，每年更新）
  acceptanceRate      Float?
  avgOfferGrade       String?
  intlStudentRatio    Float?
  mainlandChinaCohort Int?
  dataYear            Int?
  verifiedAt          DateTime? // 最后由管理员核对官方来源的时间

  requirementsText String?
  applications     Application[]

  @@index([universityId])
  @@index([applyRoute])
}

// ---------- 申请 ----------
enum ChoiceType {
  UCAS_CHOICE
  HK_DIRECT
}

enum AppStatus {
  PLANNING
  IN_PROGRESS
  SUBMITTED
  INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
  WITHDRAWN
}

model Application {
  id          String                @id @default(cuid())
  studentId   String
  student     StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId   String
  program     Program               @relation(fields: [programId], references: [id])
  choiceType  ChoiceType
  status      AppStatus             @default(PLANNING)
  externalRef String?
  submittedAt DateTime?
  offer       Offer?
  documents   ApplicationDocument[]
  tasks       Task[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([studentId])
  @@index([programId])
}

enum OfferType {
  CONDITIONAL
  UNCONDITIONAL
}

enum OfferDecision {
  FIRM
  INSURANCE
  DECLINE
  ACCEPTED
}

model Offer {
  id            String         @id @default(cuid())
  applicationId String         @unique
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          OfferType
  conditions    String?
  decision      OfferDecision?
  deadline      DateTime?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
}

// ---------- 资料 ----------
enum DocType {
  TRANSCRIPT
  PASSPORT
  PREDICTED_GRADES
  IELTS
  TOEFL
  CERTIFICATE
  PHOTO
  OTHER
}

model Document {
  id        String                @id @default(cuid())
  ownerId   String
  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      DocType
  fileKey   String // 存储适配器的 key
  fileName  String
  mime      String?
  size      Int?
  createdAt DateTime              @default(now())
  links     ApplicationDocument[]

  @@index([ownerId])
}

model ApplicationDocument {
  applicationId String
  documentId    String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId])
}

// ---------- 学生自提课题（AI 辅助结构化） ----------
enum StudentProjectStatus {
  DRAFT
  ACTIVE
  COMPLETE
}

model StudentProject {
  id         String               @id @default(cuid())
  ownerId    String
  owner      User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  field      String // 专业领域（ProjectField 值或自由文本）
  summary    String?
  ideaInputs Json // 学生填写的原始想法（研究问题/动机/方法/变量）
  structure  Json? // AI 生成并经学生编辑的课题结构（阶段/指标/反思/psUse）
  progress   Json? // 学生进度（每阶段提交/文件/反思笔记）
  status     StudentProjectStatus @default(DRAFT)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([ownerId])
}

// ---------- 交互式填表助手（申请材料准备，不代登录/代填/代提交） ----------
enum AppPrepRegion {
  UK_UCAS
  HK
}

model ApplicationPrep {
  id        String        @id @default(cuid())
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  region    AppPrepRegion
  data      Json // { sectionId: { fields..., done: bool } } 学生准备好的各栏内容
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())

  @@unique([ownerId, region])
  @@index([ownerId])
}

// ---------- 文书 ----------
enum PsKind {
  UK_UCAS_3Q
  HK_ESSAY
}

model PersonalStatement {
  id        String                     @id @default(cuid())
  studentId String
  student   StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind      PsKind
  title     String?
  content   Json // UK: { q1, q2, q3 }；HK: { body }
  wordCount Int                        @default(0)
  status    String                     @default("DRAFT")
  versions  PersonalStatementVersion[]
  updatedAt DateTime                   @updatedAt
  createdAt DateTime                   @default(now())

  @@index([studentId])
}

model PersonalStatementVersion {
  id          String            @id @default(cuid())
  statementId String
  statement   PersonalStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  content     Json
  createdAt   DateTime          @default(now())

  @@index([statementId])
}

// ---------- 时间线 / 任务 ----------
enum TaskStatus {
  TODO
  DOING
  DONE
}

model Task {
  id            String         @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title         String
  category      String? // DOC / WRITING / SUBMIT / TEST / INTERVIEW
  dueDate       DateTime?
  status        TaskStatus     @default(TODO)
  createdAt     DateTime       @default(now())

  @@index([studentId])
  @@index([applicationId])
}

// ---------- 内容 / 合规 ----------
model ContentArticle {
  id        String   @id @default(cuid())
  slug      String
  locale    String
  title     String
  body      String
  category  String?
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}

// ---------- 入学笔试练习记录 ----------

model ExamSession {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId      String // "mat" | "step" | "engaa"
  mode        String // "practice" | "mock"
  totalEarned Int
  totalMax    Int
  timeUsedSec Int?
  paperId     String?
  presetId    String?
  startedAt   DateTime?
  completedAt DateTime       @default(now())
  clientMeta  Json?
  answers     ExamAnswer[]
  createdAt   DateTime       @default(now())

  @@index([studentId])
  @@index([testId])
}

model ExamAnswer {
  id         String      @id @default(cuid())
  sessionId  String
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  type       String // "mcq" | "long"
  selected   String? // MCQ: 所选选项
  work       Json? // 大题: { "(i)": "...", ... }
  earned     Int
  max        Int
  feedback   Json? // AI 评分 perPart 数组

  timeSpentSec  Int?
  answerChanges Int     @default(0)
  visits        Int     @default(1)
  flagged       Boolean @default(false)
  firstSelected String?

  @@index([sessionId])
}

enum CalibrationDecisionStatus {
  APPROVED
  DISMISSED
  ROLLED_BACK
}

model CalibrationDecision {
  id             String                    @id @default(cuid())
  questionId     String
  testId         String
  fromDifficulty Int
  toDifficulty   Int
  status         CalibrationDecisionStatus
  metrics        Json
  note           String?
  actorId        String?
  actor          User?                     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([questionId, createdAt])
  @@index([testId, status])
}

// ---------- Phase 2 预留（暂不建表）----------
// model Mentor { ... }            // 真人导师
// model Booking { ... }           // 预约
// model Order / Payment { ... }   // 支付订单
// model Reference { ... }         // 推荐信
// model Notification { ... }      // 通知记录
// model Embedding { ... }         // pgvector 向量（RAG）

model BackgroundItem {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  catalogId  String? // 指向推荐目录项；自定义项为空
  title      String
  category   String // COMPETITION / RESEARCH / ACTIVITY / SUMMER_SCHOOL
  field      String? // CS_ENG / ECON / MATH / SCIENCE / MED
  status     String         @default("PLANNED") // PLANNED / IN_PROGRESS / DONE
  notes      String?
  targetDate DateTime?
  createdAt  DateTime       @default(now())

  @@index([studentId])
}

model PhoneCode {
  phone      String   @id
  code       String
  expiresAt  DateTime
  lastSentAt DateTime
  createdAt  DateTime @default(now())
}
