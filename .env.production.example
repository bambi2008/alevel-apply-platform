# Public host. APP_DOMAIN has no scheme; APP_ORIGIN must use HTTPS.
APP_DOMAIN=apply.example.com
APP_ORIGIN=https://apply.example.com
AUTH_URL=https://apply.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters

# The password in DATABASE_URL must be URL-encoded when it contains symbols.
POSTGRES_USER=qiaoshen
POSTGRES_DB=qiaoshen
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://qiaoshen:replace-with-url-encoded-password@postgres:5432/qiaoshen

# Single-host persistent storage. Move to an object-store adapter before scaling out.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/.storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true

# Encrypted database + upload backup.
REQUIRE_BACKUPS=true
BACKUP_DIR=/backups
BACKUP_RETENTION_COUNT=14
BACKUP_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional AI grading and monitoring.
AI_ENABLED=false
DEEPSEEK_API_KEY=
SENTRY_DSN=
